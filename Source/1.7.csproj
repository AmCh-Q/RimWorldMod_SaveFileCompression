<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Framework properties
		https://learn.microsoft.com/en-us/dotnet/core/project-sdk/msbuild-props#framework-properties -->
		<TargetFramework>net10.0</TargetFramework>
		<!-- Language options
		https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/compiler-options/language -->
		<DefineConstants>$(DefineConstants);v1_6;</DefineConstants>
		<!-- Disable generated dependency file, as this is a mod, not standalone app
		2026-10-12: There is no official documentation of it yet, so source code below
		https://github.com/dotnet/sdk/blob/a9d9e0a552ee177088ded0ef09f6061a44223596/src/Tasks/Microsoft.NET.Build.Tasks/build/Microsoft.NET.Sdk.targets#L93-L108 -->
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4985-unstable" />
		<PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.3" />
	</ItemGroup>
</Project>
